{
  "name": "pointers-box",
  "productName": "Pointers-BOX",
  "version": "2.0.0",
  "description": "Pointers-BOX 平台资源领取客户端",
  "main": "./out/main/index.js",
  "author": {
    "name": "Pointers",
    "email": "PointersMZX@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/PointersMZX/Pointers-BOX.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:icons": "node scripts/gen-icons.mjs",
    "build:win": "node scripts/build-win.mjs",
    "test:download": "start /B node scripts/dl-test-server.mjs && node scripts/dl-deep-test.mjs",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir",
    "package:win:x64": "pnpm run package:dir --x64 -c.directories.output=release/win-x64",
    "package:win:win7": "pnpm run package:dir --x64 -c.directories.output=release/win7-x64",
    "package:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac dmg --x64",
    "package:linux": "electron-vite build && electron-builder --config electron-builder.yml --linux deb AppImage --x64",
    "publish": "electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.4",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "electron-updater": "^6.3.9",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  }
}