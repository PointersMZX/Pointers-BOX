<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Pointers.Box.Core"
             x:Class="Pointers.Box.Desktop.Pages.DownloadsPage">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="980">
      <TextBlock Text="下载" FontSize="30" FontWeight="Bold" Foreground="#f0eaf8" />

      <Border Classes="glass" CornerRadius="18" Padding="18">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="下载目录" FontSize="14" FontWeight="SemiBold" Foreground="#f0eaf8" />
              <TextBlock x:Name="DirText" FontSize="12" Foreground="#a99cc4" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" x:Name="DirBox" Watermark="输入新的下载目录路径" />
            <Button Grid.Column="1" Content="应用" Click="ApplyDirClick" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="glass-alt" CornerRadius="18" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Text="添加下载" FontSize="14" FontWeight="SemiBold" Foreground="#f0eaf8" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" x:Name="UrlBox" Watermark="粘贴下载链接（.mcx 等直链）" />
            <Button Grid.Column="1" Content="开始" Click="StartClick" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="glass" CornerRadius="18" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Text="进行中 / 最近" FontSize="14" FontWeight="SemiBold" Foreground="#f0eaf8" />
          <ItemsControl x:Name="TaskList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:DownloadTask">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="13" Foreground="#f0eaf8" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                                 Foreground="{Binding StatusBrush}" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressView}"
                                 IsIndeterminate="{Binding Indeterminate}" Height="6" />
                    <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#a99cc4" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoTaskText" Text="暂无任务" FontSize="12" Foreground="#a99cc4" IsVisible="False" />
        </StackPanel>
      </Border>

      <Border Classes="glass-alt" CornerRadius="18" Padding="18">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="历史" FontSize="14" FontWeight="SemiBold" Foreground="#f0eaf8" />
            <Button Grid.Column="1" Content="清空" Click="ClearHistoryClick" />
          </Grid>
          <ItemsControl x:Name="HistoryList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:DownloadRecord">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontSize="13" Foreground="#f0eaf8" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Foreground="#a99cc4"
                               Text="{Binding CompletedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="目录" Click="OpenDirClick" Tag="{Binding}" />
                    <Button Content="删除" Click="DeleteRecordClick" Tag="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoHistoryText" Text="暂无历史" FontSize="12" Foreground="#a99cc4" IsVisible="False" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
