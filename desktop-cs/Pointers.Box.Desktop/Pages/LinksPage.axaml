<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Pointers.Box.Core"
             x:Class="Pointers.Box.Desktop.Pages.LinksPage">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="980">
      <TextBlock Text="链接" FontSize="30" FontWeight="Bold" Foreground="#f0eaf8" />
      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" x:Name="NameBox" Watermark="链接名称" />
        <TextBox Grid.Column="1" x:Name="UrlBox" Watermark="https://…" />
        <Button Grid.Column="2" Content="添加" Click="AddClick" />
      </Grid>
      <ItemsControl x:Name="LinkList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:UserLink">
            <Border CornerRadius="14" Padding="14" Margin="0,0,0,10"
                    Background="#241c2e" BorderBrush="#4a3f5c" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#f0eaf8" />
                  <TextBlock Text="{Binding Url}" FontSize="12" Foreground="#7c5cff" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="删除" Click="DeleteClick" Tag="{Binding Id}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
