<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Pointers.Box.Core"
             x:Class="Pointers.Box.Desktop.Pages.BrowserPage">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="980">
      <TextBlock Text="浏览器" FontSize="30" FontWeight="Bold" Foreground="#f0eaf8" />

      <Border Classes="glass" CornerRadius="18" Padding="18">
        <StackPanel>
          <TextBlock Text="打开链接" FontSize="14" FontWeight="SemiBold" Foreground="#f0eaf8" />
          <TextBlock Text="以系统默认浏览器打开（内嵌浏览器将于后续版本提供）" FontSize="12" Foreground="#a99cc4" Margin="0,4,0,10" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" x:Name="UrlBox" Watermark="粘贴或输入网址，例如 https://…" />
            <Button Grid.Column="1" Content="打开" Click="OpenCustomClick" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="glass-alt" CornerRadius="18" Padding="18">
        <StackPanel>
          <TextBlock Text="资源快捷链接" FontSize="14" FontWeight="SemiBold" Foreground="#f0eaf8" Margin="0,0,0,8" />
          <ItemsControl x:Name="QuickLinkList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:Resource">
                <StackPanel Spacing="6" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" Foreground="#f0eaf8" />
                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="12" Foreground="#7c5cff" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Links}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Content="{Binding}" FontSize="13" Foreground="#a99cc4"
                                Background="Transparent" BorderThickness="0" Padding="2"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Tag="{Binding}" Click="QuickLinkClicked" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
