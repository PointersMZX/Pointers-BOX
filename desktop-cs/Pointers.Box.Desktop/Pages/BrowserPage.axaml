<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Pointers.Box.Desktop.Pages"
             x:Class="Pointers.Box.Desktop.Pages.BrowserPage">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- 工具栏：新标签 + 地址栏 + 前往/刷新/关闭标签 -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
      <Button Grid.Column="0" x:Name="NewTabBtn" Content="＋ 新标签" Click="NewTabClick" />
      <TextBox Grid.Column="1" x:Name="UrlBox" Watermark="输入网址，例如 pointers-box.cc.cd" KeyDown="UrlKeyDown" />
      <Button Grid.Column="2" Content="前往" Click="GoClick" />
      <Button Grid.Column="3" Content="⟳" Click="ReloadClick" />
      <Button Grid.Column="4" x:Name="CloseTabBtn" Content="✕" Click="CloseTabClick" IsVisible="False" />
    </Grid>
    <!-- 多标签条（多标签时显示） -->
    <ItemsControl Grid.Row="1" x:Name="TabBar" IsVisible="False" Margin="0,0,0,8">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="pages:BrowserTab">
          <Button Click="TabClick" Background="#33ffffff" BorderBrush="#29ffffff" BorderThickness="1" CornerRadius="8" Padding="10,4">
            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#f0eaf8" MaxWidth="140" TextTrimming="CharacterEllipsis" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- 内嵌网页承载区：WebView2 真内嵌渲染 -->
    <Border Grid.Row="2" x:Name="WebHost" CornerRadius="14" ClipToBounds="True" />
    <!-- WebView 未就绪占位 -->
    <Border Grid.Row="2" x:Name="WebPlaceholder" Classes="glass-alt" CornerRadius="18" Padding="30" IsVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="520">
        <TextBlock Text="正在加载网页组件…" FontSize="16" Foreground="#f0eaf8" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <!-- 状态栏 -->
    <TextBlock Grid.Row="3" x:Name="StatusLine" Text="" FontSize="11" Foreground="#a99cc4" Margin="0,6,0,0" />
  </Grid>
</UserControl>
