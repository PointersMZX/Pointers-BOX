<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Pointers.Box.Core"
             x:Class="Pointers.Box.Desktop.Pages.ResourcesPage">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" MaxWidth="980">
      <TextBlock Text="资源" FontSize="30" FontWeight="Bold" Foreground="#f0eaf8" />
      <TextBox x:Name="SearchBox" Watermark="搜索资源名称/简介" TextChanged="SearchChanged" />
      <ListBox x:Name="CategoryList" SelectionChanged="CategoryChanged" SelectionMode="Single">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      </ListBox>
      <ItemsControl x:Name="ResourceList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:Resource">
            <Border Classes="glass" CornerRadius="18" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#f0eaf8" />
                  <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="12" Foreground="#7c5cff" />
                </Grid>
                <TextBlock Text="{Binding Introduction}" FontSize="13" Foreground="#a99cc4" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
