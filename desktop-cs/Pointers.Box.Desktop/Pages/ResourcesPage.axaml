<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Pointers.Box.Core"
             xmlns:pages="using:Pointers.Box.Desktop.Pages"
             x:Class="Pointers.Box.Desktop.Pages.ResourcesPage">
  <Panel>
    <!-- 列表视图 -->
    <ScrollViewer x:Name="ListView" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" MaxWidth="980">
        <TextBlock Text="资源" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TText}" />
        <TextBox x:Name="SearchBox" Watermark="搜索资源名称/简介" TextChanged="SearchChanged" />
        <ListBox x:Name="CategoryList" SelectionChanged="CategoryChanged" SelectionMode="Single">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <ItemsControl x:Name="ResourceList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:Resource">
              <Border Classes="glass" CornerRadius="18" Padding="18" Margin="0,0,0,12" Cursor="Hand"
                      PointerPressed="ResourceClick">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource TAccent}" />
                  </Grid>
                  <TextBlock Text="{Binding Introduction}" FontSize="13" Foreground="{DynamicResource TTextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoResult" Text="没有匹配的资源" FontSize="13" Foreground="{DynamicResource TTextMuted}" IsVisible="False" HorizontalAlignment="Center" />
      </StackPanel>
    </ScrollViewer>
    <!-- 详情视图（页内切换；宿主代码构建 ResourceDetailPanel） -->
    <ScrollViewer x:Name="DetailView" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="DetailHost" MaxWidth="760" />
    </ScrollViewer>
  </Panel>
</UserControl>
