<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pointers.Box.Desktop.Pages.PlaceholderPage">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
    <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold" Foreground="#f0eaf8" HorizontalAlignment="Center" />
    <TextBlock x:Name="DescText" Foreground="#a99cc4" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
