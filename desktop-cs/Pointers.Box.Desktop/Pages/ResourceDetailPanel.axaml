<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pointers.Box.Desktop.Pages.ResourceDetailPanel">
  <Border Classes="glass" CornerRadius="18" Padding="24">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="DetailName" Text="" FontSize="22" FontWeight="Bold" Foreground="#f0eaf8" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="✕ 返回" Click="CloseClick" VerticalAlignment="Top" />
      </Grid>
      <TextBlock x:Name="DetailMeta" Text="" FontSize="12" Foreground="#7c5cff" />
      <TextBlock x:Name="DetailIntro" Text="" FontSize="13" Foreground="#a99cc4" TextWrapping="Wrap" />
      <TextBlock Text="分享项" FontSize="15" FontWeight="SemiBold" Foreground="#f0eaf8" Margin="0,6,0,0" />
      <StackPanel x:Name="ShareList" Spacing="8" />
      <Button x:Name="FavButton" Content="☆ 收藏" Click="FavClick" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</UserControl>
