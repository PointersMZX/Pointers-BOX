<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pointers.Box.Desktop.MainWindow"
        Title="Pointers-BOX" Width="1280" Height="800"
        MinWidth="960" MinHeight="640" Background="#0d0817">
  <Grid ColumnDefinitions="220,*">
    <StackPanel Grid.Column="0" Margin="16,24,16,16" Spacing="6">
      <TextBlock Text="Pointers-BOX" FontSize="22" FontWeight="Bold" Foreground="#e8e0f5" Margin="8,0,0,18" />
      <Button x:Name="NavHome" Content="首页" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button x:Name="NavResources" Content="资源" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button x:Name="NavLinks" Content="链接" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button x:Name="NavBrowser" Content="浏览器" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button x:Name="NavDownloads" Content="下载" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button x:Name="NavSettings" Content="设置" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
    </StackPanel>

    <ContentControl x:Name="PageHost" Grid.Column="1" Margin="0,24,24,16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</Window>
