<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pointers.Box.Desktop.MainWindow"
        Title="Pointers-BOX" Width="1280" Height="800"
        MinWidth="960" MinHeight="640" Background="#0d0817">
  <Grid ColumnDefinitions="220,*">
    <StackPanel Grid.Column="0" Margin="16,24,16,16" Spacing="6">
      <TextBlock Text="Pointers-BOX" FontSize="22" FontWeight="Bold" Foreground="#e8e0f5" Margin="8,0,0,18" />
      <Button Content="首页" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button Content="资源" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button Content="链接" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button Content="浏览器" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button Content="下载" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      <Button Content="设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
    </StackPanel>

    <StackPanel Grid.Column="1" Margin="0,24,24,16" Spacing="16" MaxWidth="980">
        <TextBlock Text="主页" FontSize="30" FontWeight="Bold" Foreground="#f0eaf8" />
        <TextBlock Text="今日推荐" FontSize="18" FontWeight="SemiBold" Foreground="#c9bfe0" />
        <ItemsControl x:Name="RecommendList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="static" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border CornerRadius="18" Padding="20" Background="#241c2e" BorderBrush="#4a3f5c" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="公告" FontSize="16" FontWeight="SemiBold" Foreground="#f0eaf8" />
            <TextBlock x:Name="AnnouncementText" Text="（加载中）" FontSize="13" Foreground="#a99cc4" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
  </Grid>
</Window>
