<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pointers.Box.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- 主题动态资源（ThemeManager.Apply 运行时改写；默认紫金黑） -->
    <SolidColorBrush x:Key="TAppBgBrush" Color="#0d0817" />
    <SolidColorBrush x:Key="TText" Color="#f0eaf8" />
    <SolidColorBrush x:Key="TTextMuted" Color="#a99cc4" />
    <SolidColorBrush x:Key="TAccent" Color="#7c5cff" />
    <SolidColorBrush x:Key="TNavIdle" Color="#a99cc4" />
    <SolidColorBrush x:Key="TCardBorder" Color="#1affffff" />
    <SolidColorBrush x:Key="TGlassBg" Color="#5C2A2135" />
    <SolidColorBrush x:Key="TGlassBorder" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="TGlassAltBg" Color="#52241C2E" />
    <SolidColorBrush x:Key="TGlassAltBorder" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="TBtnBg" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TBtnOver" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="TBtnBorder" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="TInputBg" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TInputBorder" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="TRowBg" Color="#14241c2e" />
    <x:String x:Key="TGlassShadow">inset 0 1 0 0 #4DFFFFFF, inset 0 -1 0 0 #14FFFFFF, inset 0 0 28 0 #0DFFFFFF, 0 10 34 0 #59030014</x:String>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- 液态玻璃材质（六层配方，紫金黑 dark 预设；主题色走动态资源） -->
    <Style Selector="Border.glass">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Background" Value="{DynamicResource TGlassBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TGlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource TGlassShadow}" />
    </Style>
    <!-- 次级玻璃卡 -->
    <Style Selector="Border.glass-alt">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Background" Value="{DynamicResource TGlassAltBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TGlassAltBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource TGlassShadow}" />
    </Style>
    <!-- 全局按钮：玻璃底色盖掉 Fluent 蓝高亮 -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource TBtnBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TText}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource TBtnBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TBtnOver}" />
      <Setter Property="Foreground" Value="{DynamicResource TText}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TBtnOver}" />
      <Setter Property="Foreground" Value="{DynamicResource TText}" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource TAccent}" />
    </Style>
    <!-- TextBox：玻璃输入底 -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource TInputBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TInputBorder}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource TInputBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TBtnOver}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource TAccent}" />
      <Setter Property="Background" Value="{DynamicResource TInputBg}" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TText}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TText}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TText}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource TAccent}" />
    </Style>
    <!-- 导航胶囊按钮 -->
    <Style Selector="Button.glass-nav">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </Application.Styles>
</Application>
